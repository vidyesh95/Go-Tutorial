# Copy to .env and edit (".env" is git-ignored). Load it into your shell with:
#   set -a; source 05-projects/taskapi/.env; set +a
# Every variable except the secret is optional; defaults are shown.

# REQUIRED. At least 32 bytes. Generate: openssl rand -base64 48
TASKAPI_JWT_SECRET=

TASKAPI_ADDR=:8080
TASKAPI_DB_PATH=taskapi.db
TASKAPI_JWT_TTL=24h
TASKAPI_LOG_LEVEL=info          # debug | info | warn | error
TASKAPI_LOG_FORMAT=json         # json | text (text is nicer in a terminal)
TASKAPI_RATE_RPS=10             # sustained requests per second, per client IP
TASKAPI_RATE_BURST=20           # short bursts allowed above the sustained rate
TASKAPI_CORS_ORIGINS=           # comma-separated, e.g. http://localhost:3000,https://app.example.com
TASKAPI_SHUTDOWN_TIMEOUT=15s    # how long to wait for in-flight requests on SIGINT/SIGTERM
