# Copy to .env and edit (".env" is git-ignored). Load it into your shell with:
#   set -a; source 05-projects/taskapi/.env; set +a
# Every variable except the secret is optional; defaults are shown.

# REQUIRED. At least 32 bytes. Generate: openssl rand -base64 48
TASKAPI_JWT_SECRET=

TASKAPI_ADDR=:8080
TASKAPI_DB_PATH=taskapi.db
TASKAPI_JWT_TTL=24h
TASKAPI_LOG_LEVEL=info          # debug | info | warn | error
TASKAPI_LOG_FORMAT=json         # json | text (text is nicer in a terminal)
TASKAPI_RATE_RPS=10             # sustained requests per second, per client IP
TASKAPI_RATE_BURST=20           # short bursts allowed above the sustained rate
TASKAPI_CORS_ORIGINS=           # comma-separated, e.g. http://localhost:3000,https://app.example.com
TASKAPI_SHUTDOWN_TIMEOUT=15s    # how long to wait for in-flight requests on SIGINT/SIGTERM

# --- Cookie-session authentication (the second auth mode; JWT keeps working alongside) ---------
TASKAPI_SESSION_TTL=168h        # session lifetime after last refresh (168h = 7 days; Go durations have no "d")
TASKAPI_SESSION_UPDATE_AGE=24h  # sliding expiry: extend an active session at most this often
TASKAPI_COOKIE_SECURE=true      # Secure cookie flag. Set to false ONLY for local plain-http development
                                # (curl and Safari will not send Secure cookies to http://)
TASKAPI_PUBLIC_URL=http://localhost:8080   # externally visible base URL: used in emailed links and as
                                           # the GitHub OAuth callback host. https://... in production
TASKAPI_AUTH_RATE_RPS=0.5       # stricter per-IP limit for sign-in/sign-up/password reset (30/min)
TASKAPI_AUTH_RATE_BURST=10

# --- "Sign in with GitHub" (optional; routes answer 404 unless BOTH are set) ----------------------
# Create an OAuth App at https://github.com/settings/developers with the callback URL
#   $TASKAPI_PUBLIC_URL/v1/session-auth/oauth/github/callback
TASKAPI_GITHUB_CLIENT_ID=
TASKAPI_GITHUB_CLIENT_SECRET=
